
#include <iostream>
using namespace std;

int main()
{
    int bookID[5], temp;

    cout << "Enter 5 book IDs:" << endl;

    for(int i = 0; i < 5; i++)
    {
        cin >> bookID[i];
    }

    // Sorting in ascending order
    for(int i = 0; i < 5; i++)
    {
        for(int j = 0; j < 4 - i; j++)
        {
            if(bookID[j] > bookID[j + 1])
            {
                temp = bookID[j];
                bookID[j] = bookID[j + 1];
                bookID[j + 1] = temp;
            }
        }
    }

    cout << "Book IDs in Ascending Order:" << endl;

    for(int i = 0; i < 5; i++)
    {
        cout << bookID[i] << " ";
    }

    return 0;
}
