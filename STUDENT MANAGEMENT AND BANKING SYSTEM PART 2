
#include <iostream>
using namespace std;

int main()
{
    int rollNo[5], searchNo;
    int found = 0;

    cout << "Enter Roll Numbers of 5 students:" << endl;

    for(int i = 0; i < 5; i++)
    {
        cin >> rollNo[i];
    }

    cout << "Enter Roll Number to search: ";
    cin >> searchNo;

    for(int i = 0; i < 5; i++)
    {
        if(rollNo[i] == searchNo)
        {
            found = 1;
            break;
        }
    }

    if(found == 1)
    {
        cout << "Student Found";
    }
    else
    {
        cout << "Student Not Found";
    }

    return 0;
}
