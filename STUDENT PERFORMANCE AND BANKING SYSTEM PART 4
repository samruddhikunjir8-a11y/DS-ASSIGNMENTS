
#include <iostream>
using namespace std;

int main()
{
    int rollNo[100], marks[100];
    int n = 0, choice, searchNo, found;

    do
    {
        cout << "\n--- Student Management System ---" << endl;
        cout << "1. Add Student" << endl;
        cout << "2. Display Student Records" << endl;
        cout << "3. Search Student" << endl;
        cout << "4. Exit" << endl;

        cout << "Enter your choice: ";
        cin >> choice;

        switch(choice)
        {
            case 1:
                cout << "Enter Roll Number: ";
                cin >> rollNo[n];

                cout << "Enter Marks: ";
                cin >> marks[n];

                n++;

                cout << "Student added successfully!" << endl;
                break;

            case 2:
                cout << "\nStudent Records:" << endl;

                for(int i = 0; i < n; i++)
                {
                    cout << "Roll Number: " << rollNo[i] << endl;
                    cout << "Marks: " << marks[i] << endl;
                }
                break;

            case 3:
                cout << "Enter Roll Number to search: ";
                cin >> searchNo;

                found = 0;

                for(int i = 0; i < n; i++)
                {
                    if(rollNo[i] == searchNo)
                    {
                        found = 1;

                        cout << "Student Found!" << endl;
                        cout << "Roll Number: " << rollNo[i] << endl;
                        cout << "Marks: " << marks[i] << endl;

                        break;
                    }
                }

                if(found == 0)
                {
                    cout << "Student Not Found" << endl;
                }
                break;

            case 4:
                cout << "Exiting Student Management System..." << endl;
                break;

            default:
                cout << "Invalid Choice!" << endl;
        }

    } while(choice != 4);

    return 0;
}
