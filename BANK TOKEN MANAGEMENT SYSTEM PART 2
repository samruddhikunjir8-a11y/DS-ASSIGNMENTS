
#include <iostream>
using namespace std;

int main()
{
    int stack[5];
    int top = -1;

    cout << "Enter 5 recently served customer token numbers:" << endl;

    for(int i = 0; i < 5; i++)
    {
        cin >> stack[++top];
    }

    cout << "\nCustomer Service History:" << endl;

    while(top >= 0)
    {
        cout << "Token Number: " << stack[top] << endl;
        top--;
    }

    return 0;
}
