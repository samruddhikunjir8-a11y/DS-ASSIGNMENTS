
#include <iostream>
using namespace std;

int main()
{
    int bookID[5], searchID;
    int found = 0;

    cout << "Enter 5 book IDs:" << endl;

    for(int i = 0; i < 5; i++)
    {
        cin >> bookID[i];
    }

    cout << "Enter Book ID to search: ";
    cin >> searchID;

    for(int i = 0; i < 5; i++)
    {
        if(bookID[i] == searchID)
        {
            found = 1;
            break;
        }
    }

    if(found == 1)
    {
        cout << "Book Found";
    }
    else
    {
        cout << "Book Not Found";
    }

    return 0;
}
